{
  "name": "@saad5400/html-to-pdf",
  "version": "0.1.0",
  "description": "Production-grade HTML/URL to PDF conversion service and CLI — Fastify + Playwright + BullMQ",
  "type": "module",
  "license": "MIT",
  "author": "Saad5400 <saad@sb.sa>",
  "homepage": "https://github.com/Saad5400/html-to-pdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saad5400/html-to-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/Saad5400/html-to-pdf/issues"
  },
  "keywords": [
    "html",
    "pdf",
    "html-to-pdf",
    "url-to-pdf",
    "playwright",
    "chromium",
    "fastify",
    "bullmq",
    "pdf-cli",
    "render",
    "headless"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "htp": "dist/cli/htp.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker/index.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "minimal": "MODE=minimal AUTH_REQUIRED=false tsx src/server.ts",
    "cli": "tsx src/cli/htp.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "openapi": "tsx scripts/emit-openapi.ts > openapi.yaml",
    "loadtest": "tsx scripts/loadtest.ts",
    "visual": "tsx scripts/visual-render.ts",
    "visual:calibrate": "tsx scripts/visual-calibrate.ts",
    "visual:dump": "tsx scripts/visual-dump.ts",
    "local": "bash scripts/local.sh",
    "prepare": "playwright install --with-deps chromium || true",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/sensible": "^6.0.1",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.2.6",
    "argon2": "^0.44.0",
    "bullmq": "^5.76.8",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.1.11",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@types/node": "^26.1.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "pdfjs-dist": "^6.1.200",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
